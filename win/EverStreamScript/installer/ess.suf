<IDS_CTRL_RADIOBTN_PERUSER>Izveidot îsinâjumikonas dotajam sistçmas lietotâjam</IDS_CTRL_RADIOBTN_PERUSER>
<IDS_CTRL_RADIOBTN_ALLUSERS>Izveidot îsinâjumikonas pieejamas visiem sistçmas lietotâjiem</IDS_CTRL_RADIOBTN_ALLUSERS>
<IDS_CTRL_COMBOBOX_SHORTCUTFOLDERS>%AppShortcutFolderName%</IDS_CTRL_COMBOBOX_SHORTCUTFOLDERS>
</Messages>
</SUF70Messages>
